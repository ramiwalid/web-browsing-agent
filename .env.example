# To separate your traces from other application
LANGSMITH_PROJECT=new-agent
# LANGSMITH_API_KEY=lsv2...

# Model under test (Claude, via browser-use's ChatAnthropic)
ANTHROPIC_API_KEY=

# Stop browser-use from sending anonymized usage telemetry (posthog) and cloud sync
ANONYMIZED_TELEMETRY=false
BROWSER_USE_CLOUD_SYNC=false

# Postgres for storing promptfoo eval runs. Local default shown; for the shared team
# database, get the connection string from the project owner. Leave empty to disable.
# Create tables once with: python -m agent.db init
DATABASE_URL=postgresql://localhost:5432/malvertising_audit
